{
  "name": "faculty-reservation-server-fixed",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "load-test": "npx artillery run tests/load/load-test.yml",
    "load-test:quick": "npx artillery run tests/load/quick-test.yml",
    "test": "node --test tests/*.test.js",
    "migrate": "node scripts/database.js",
    "db:setup": "node scripts/database.js --create-database",
    "create-admin": "node scripts/create-admin.js",
    "seed": "node scripts/seed.js",
    "test:integration": "node --test tests/database.integration.js",
    "catalog:configure": "node scripts/configure-catalog.js",
    "email:check": "node scripts/check-email.js",
    "backup": "node scripts/backup.js",
    "backup:restore": "node scripts/backup.js --restore",
    "email:worker": "node scripts/email-worker.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "nodemailer": "^10.1.2"
  }
}
